# Transactional email + newsletter — Brevo (EU)
# Used by: /api/newsletter (contacts), /api/contact + /api/demo-request (transactional).
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SENDER_EMAIL=noreply@lnaflow.com
BREVO_SENDER_NAME=LNA
BREVO_CONTACT_INBOX=hello@lnaflow.com

# Live Chat — Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Analytics — Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site origin (defaults to https://lnaflow.com when unset)
NEXT_PUBLIC_SITE_URL=https://lnaflow.com
