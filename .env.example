# Outbound email — Google Workspace SMTP relay (no provider account, no API keys).
# Auth is by source IP (set in Admin console → Gmail → Routing → SMTP relay service).
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
# EHLO greeting name — must be an FQDN (Google rejects bare hostnames with 421)
SMTP_NAME=lnaflow.com
# Bind outbound to this source IP (the relay IP-allowlist is IPv4-only)
SMTP_LOCAL_ADDRESS=
# Only set these if the relay requires SMTP AUTH; leave unset for IP-based auth.
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@lnaflow.com
SMTP_FROM_NAME=LNA
CONTACT_INBOX=hello@lnaflow.com

# Live Chat — Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Analytics — Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site origin (defaults to https://lnaflow.com when unset)
NEXT_PUBLIC_SITE_URL=https://lnaflow.com
