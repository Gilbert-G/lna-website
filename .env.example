# Transactional + newsletter email — Mailjet (Free plan, EU)
# Used by /api/contact + /api/demo-request (transactional) and /api/newsletter (contacts).
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_SENDER_EMAIL=noreply@lnaflow.com
MAILJET_SENDER_NAME=LNA
MAILJET_CONTACT_INBOX=hello@lnaflow.com
MAILJET_LIST_ID=

# Live Chat — Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Analytics — Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site origin (defaults to https://lnaflow.com when unset)
NEXT_PUBLIC_SITE_URL=https://lnaflow.com
